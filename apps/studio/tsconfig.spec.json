/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "./tsconfig.json",
  /* `types: []` matches tsconfig.app.json: no ambient @types are pulled in, only what a file
   * actually imports. It was `["vitest/globals"]`, which types a `describe`/`it`/`expect` that no
   * spec uses — every spec imports them from 'vitest' explicitly. Config that advertises a style
   * the codebase does not follow is worse than no config: it is the first thing someone copies. */
  "compilerOptions": {
    "types": []
  },
  "include": ["src/**/*.d.ts", "src/**/*.spec.ts", "src/test-setup.ts"]
}
