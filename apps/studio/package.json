{
  "name": "@atlas/studio",
  "version": "0.1.0",
  "private": true,
  "description": "Studio — the Angular SPA that is Atlas' only user-facing interface. A VS Code-style workbench where every panel, view and action is permission-gated by the same @atlas/policy the services enforce with.",
  "scripts": {
    "start": "ng serve",
    "build": "ng build",
    "test": "ng test",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@angular/cdk": "^22.2.1",
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/forms": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/router": "^22.2.1",
    "@atlas/policy": "*",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.1",
    "jsdom": "^30.1.2",
    "typescript": "~6.0.2",
    "vitest": "^4.1.11"
  }
}
