{
  "name": "@atlas/studio",
  "version": "0.1.0",
  "private": true,
  "description": "Studio — the Angular SPA that is Atlas' only user-facing interface. A VS Code-style workbench where every panel, view and action is permission-gated by the same @atlas/policy the services enforce with.",
  "scripts": {
    "start": "ng serve",
    "build": "ng build",
    "test": "ng test",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@angular/cdk": "^22.2.5",
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/platform-browser": "^22.2.4",
    "@angular/router": "^22.2.4",
    "@atlas/contracts": "*",
    "@atlas/policy": "*",
    "@foblex/2d": "^1.2.2",
    "@foblex/flow": "^19.4.0",
    "@foblex/mediator": "^1.1.3",
    "@foblex/platform": "^1.0.4",
    "@foblex/utils": "^1.1.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.4",
    "jsdom": "^31.0.0",
    "typescript": "~6.0.2",
    "vitest": "^4.1.12"
  }
}
