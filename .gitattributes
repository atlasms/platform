# Normalize line endings so a mixed Windows/Linux/macOS team gets deterministic
# diffs and CI results. Text is stored LF in the repo regardless of checkout.
* text=auto eol=lf

# Windows-only tooling that genuinely needs CRLF.
*.ps1   text eol=crlf
*.psm1  text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf

# Must stay LF or they break when executed on Linux / in containers.
*.sh          text eol=lf
Dockerfile*   text eol=lf
*.mjs         text eol=lf
*.ts          text eol=lf

# Binary — never touch, never diff.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.mxf binary
*.mp4 binary
*.mov binary
*.wav binary

# Golden fixtures must stay byte-exact or the round-trip tests are meaningless.
*.golden.*        -text -diff
**/fixtures/**    -text

# Generated — collapsed by default in PR diffs so reviews stay readable.
#
# `linguist-generated` alone does that job. It deliberately does NOT carry `-diff`: that attribute
# makes git treat the file as binary, so `git diff` on a lock file locally shows "Bin 18176 ->
# 18166 bytes" and nothing else. Reviewing which dependency moved — the one thing a lock file diff
# is for, and the thing a security bump has to be checked against — then needs `--text` and knowing
# to reach for it. Collapsed-but-expandable is the goal; unreadable is not.
package-lock.json linguist-generated=true

# Keep docs out of the language stats; this is a platform, not a docs project.
docs/**  linguist-documentation=true
