# dependencies
node_modules/

# nx
.nx/
.nx/cache/
.nx/workspace-data/

# build output
dist/
build/
*.tsbuildinfo

# test / coverage
coverage/
.nyc_output/

# env & secrets — bootstrap config is mounted, never committed
