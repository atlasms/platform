.env
.env.*
!.env.example
*.pem
*.key

# editors / OS
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db

# logs
*.log
npm-debug.log*

# angular build cache
.angular/

# local agent tooling config — machine-specific, never committed (it leaked once, #270)
.kilo/
