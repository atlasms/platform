{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "exactOptionalPropertyTypes": true,
    "useUnknownInCatchVariables": true,
    "forceConsistentCasingInFileNames": true,

    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    "noEmit": true,
    "declaration": false,
    "sourceMap": true,

    "baseUrl": ".",
    "paths": {
      "@atlas/contracts": ["libs/contracts/src/index.ts"],
      "@atlas/messaging": ["libs/messaging/src/index.ts"],
      "@atlas/service-kit": ["libs/service-kit/src/index.ts"],
      "@atlas/policy": ["libs/policy/src/index.ts"],
      "@atlas/reference": ["libs/reference/src/index.ts"],
      "@atlas/data": ["libs/data/src/index.ts"],
      "@atlas/bms-workflow": ["libs/bms-workflow/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist", ".nx", "reference"]
}
