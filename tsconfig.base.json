{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "exactOptionalPropertyTypes": true,
    "useUnknownInCatchVariables": true,
    "forceConsistentCasingInFileNames": true,

    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    // Libraries have NO build step — package `exports` point straight at ./src/index.ts and
    // tsx/Node resolve the TypeScript at runtime, so imports carry explicit `.ts` extensions.
    // This is the supported way to typecheck that layout, and is only legal with noEmit.
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "declaration": false,
    "sourceMap": true

    // NO `baseUrl`, and NO `paths`.
    //
    // `baseUrl` is deprecated in TypeScript 6 and stops functioning in 7; it existed here only to
    // anchor `paths`. And `paths` was never doing the work: these are npm workspaces, so
    // `node_modules/@atlas/*` is a symlink to each package and `@atlas/foo` resolves through that
    // package's own `exports` field, which points straight at `./src/index.ts`.
    //
    // The proof it was dead config is that it was INCOMPLETE — `@atlas/data-pg`,
    // `@atlas/messaging-nats` and `@atlas/mam` were never listed, and every import of them
    // typechecked anyway. A partial mirror of the workspace layout that nobody has to maintain
    // correctly is worse than none: it looks authoritative while being wrong.
  },
  "exclude": ["node_modules", "dist", ".nx", "reference"]
}
