{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.example/schemas/events/ai.suggestion.raised.payload.schema.json",
  "title": "ai.suggestion.raised payload",
  "description": "Emitted by AI Enrichment with provisional suggestions for human confirmation (never auto-applied - FR-AI-3). Consumed by MAM, Notifications.",
  "type": "object",
  "required": ["assetId", "suggestions"],
  "additionalProperties": false,
  "properties": {
    "assetId": { "$ref": "../common.schema.json#/$defs/Ulid" },
    "tier": { "enum": ["online", "offline"], "description": "Which AI tier produced these." },
    "suggestions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "value"],
        "additionalProperties": false,
        "properties": {
          "kind": { "enum": ["person", "tag", "subject", "caption"] },
          "value": { "type": "string", "description": "e.g. personId, tag label, subject term, or caption text." },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    }
  }
}
