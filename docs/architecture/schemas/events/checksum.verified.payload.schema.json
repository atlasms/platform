{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.example/schemas/events/checksum.verified.payload.schema.json",
  "title": "checksum.verified payload",
  "description": "Emitted by HSM when an integrity check passes (ingest or sweep).",
  "type": "object",
  "required": ["assetId", "rendition"],
  "additionalProperties": false,
  "properties": {
    "assetId": { "$ref": "../common.schema.json#/$defs/Ulid" },
    "rendition": { "$ref": "../common.schema.json#/$defs/RenditionKind" },
    "checksum": { "$ref": "../common.schema.json#/$defs/Checksum" },
    "verifiedAt": { "type": "string", "format": "date-time" }
  }
}
