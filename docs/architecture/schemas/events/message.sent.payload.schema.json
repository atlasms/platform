{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.example/schemas/events/message.sent.payload.schema.json",
  "title": "message.sent payload",
  "description": "Emitted by Notifications & Messaging when a user sends a direct or group chat message. Consumed by the WebSocket service (live delivery) and Logging.",
  "type": "object",
  "required": ["id", "from", "to", "body", "sentAt"],
  "additionalProperties": false,
  "properties": {
    "id": { "$ref": "../common.schema.json#/$defs/Ulid", "description": "The chat message id (distinct from the envelope messageId)." },
    "from": { "type": "string", "description": "Sender user id." },
    "to": {
      "type": "array",
      "minItems": 1,
      "description": "Recipients — users and/or groups.",
      "items": {
        "type": "object",
        "required": ["kind", "id"],
        "additionalProperties": false,
        "properties": { "kind": { "enum": ["user", "group"] }, "id": { "type": "string" } }
      }
    },
    "threadId": { "$ref": "../common.schema.json#/$defs/Ulid", "description": "Conversation thread, when part of one." },
    "body": { "type": "string" },
    "sentAt": { "type": "string", "format": "date-time" }
  }
}
