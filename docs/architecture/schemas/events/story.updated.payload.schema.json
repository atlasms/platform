{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.example/schemas/events/story.updated.payload.schema.json",
  "title": "story.updated payload",
  "description": "Emitted by Newsroom when a story changes (status, assignment, script/media). Consumed by the WebSocket service (collaborative editing) and Logging.",
  "type": "object",
  "required": ["storyId", "status", "at"],
  "additionalProperties": false,
  "properties": {
    "storyId": { "$ref": "../common.schema.json#/$defs/Ulid" },
    "rundownId": { "$ref": "../common.schema.json#/$defs/Ulid", "description": "The rundown this story belongs to, if any." },
    "status": { "enum": ["assigned", "writing", "review", "ready", "onair"] },
    "changed": { "type": "array", "items": { "type": "string" }, "description": "Names of changed fields." },
    "by": { "type": "string" },
    "at": { "type": "string", "format": "date-time" }
  }
}
