<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:atlas="http://atlas.example/bpmn"
                  id="Definitions_canonical"
                  targetNamespace="http://atlas.example/bpmn">
  <bpmn:process id="wf_01J9ZKQ2M8XABCDEFGHJKMNPQR" name="Canonical ingest-to-air" isExecutable="true">
    <bpmn:extensionElements>
      <atlas:Vars>
        <atlas:Var name="assetId" type="string"/>
        <atlas:Var name="profile" type="string" initial="broadcast"/>
        <atlas:Var name="renditions" type="array"/>
        <atlas:Var name="verdict" type="string"/>
      </atlas:Vars>
    </bpmn:extensionElements>

    <bpmn:startEvent id="s_start" name="On ingest">
      <bpmn:extensionElements>
        <atlas:Trigger event="ingest.accepted"/>
      </bpmn:extensionElements>
      <bpmn:messageEventDefinition id="med_start"/>
      <bpmn:outgoing>t1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="s_transcode" name="Transcode">
      <bpmn:extensionElements>
        <atlas:Command action="transcode" event="transcode.job.create"/>
        <atlas:Retry maxAttempts="3" backoffType="exponential" initial="PT30S" factor="2" max="PT10M"/>
        <atlas:OnError mode="compensate"/>
        <atlas:Await event="transcode.completed"/>
        <atlas:Io>
          <atlas:Mapping direction="in" target="request.profile" source="= vars.profile"/>
          <atlas:Mapping direction="in" target="request.assetId" source="= vars.assetId"/>
          <atlas:Mapping direction="out" target="vars.renditions" source="= incoming.renditions"/>
        </atlas:Io>
      </bpmn:extensionElements>
      <bpmn:incoming>t1</bpmn:incoming>
      <bpmn:outgoing>t2</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:intermediateCatchEvent id="s_wait_ready" name="Await ready">
      <bpmn:extensionElements>
        <atlas:Await event="asset.ready" correlate="= incoming.assetId = vars.assetId"/>
      </bpmn:extensionElements>
      <bpmn:incoming>t2</bpmn:incoming>
      <bpmn:outgoing>t3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="med_ready"/>
    </bpmn:intermediateCatchEvent>

    <bpmn:userTask id="s_review" name="Review &amp; approve">
      <bpmn:extensionElements>
        <atlas:Assignment taskType="approve" role="editor" reviewPointId="pre-schedule" dueIn="PT4H"/>
        <atlas:Escalation after="PT2H" action="notify" role="chief-editor"/>
        <atlas:Io>
          <atlas:Mapping direction="out" target="vars.verdict" source="= incoming.outcome"/>
        </atlas:Io>
      </bpmn:extensionElements>
      <bpmn:incoming>t3</bpmn:incoming>
      <bpmn:outgoing>t4</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="s_gate" name="Approved?" default="t_reject">
      <bpmn:incoming>t4</bpmn:incoming>
      <bpmn:outgoing>t_ok</bpmn:outgoing>
      <bpmn:outgoing>t_reject</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="s_end_ok" name="Schedulable">
      <bpmn:extensionElements><atlas:End status="approved"/></bpmn:extensionElements>
      <bpmn:incoming>t_ok</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="s_end_rej" name="Rejected">
      <bpmn:extensionElements><atlas:End status="rejected"/></bpmn:extensionElements>
      <bpmn:incoming>t_reject</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="t1" sourceRef="s_start" targetRef="s_transcode"/>
    <bpmn:sequenceFlow id="t2" sourceRef="s_transcode" targetRef="s_wait_ready"/>
    <bpmn:sequenceFlow id="t3" sourceRef="s_wait_ready" targetRef="s_review"/>
    <bpmn:sequenceFlow id="t4" sourceRef="s_review" targetRef="s_gate"/>
    <bpmn:sequenceFlow id="t_ok" name="approved" sourceRef="s_gate" targetRef="s_end_ok">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="feel">= vars.verdict = "approved"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="t_reject" name="rejected" sourceRef="s_gate" targetRef="s_end_rej"/>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_canonical">
    <bpmndi:BPMNPlane id="Plane_canonical" bpmnElement="wf_01J9ZKQ2M8XABCDEFGHJKMNPQR">
      <bpmndi:BPMNShape id="di_s_start" bpmnElement="s_start">
        <dc:Bounds x="0" y="0" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_s_transcode" bpmnElement="s_transcode">
        <dc:Bounds x="180" y="-22" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_s_wait_ready" bpmnElement="s_wait_ready">
        <dc:Bounds x="360" y="0" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_s_review" bpmnElement="s_review">
        <dc:Bounds x="540" y="-22" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_s_gate" bpmnElement="s_gate" isMarkerVisible="true">
        <dc:Bounds x="720" y="-7" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_s_end_ok" bpmnElement="s_end_ok">
        <dc:Bounds x="900" y="-60" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_s_end_rej" bpmnElement="s_end_rej">
        <dc:Bounds x="900" y="60" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="di_t1" bpmnElement="t1">
        <di:waypoint x="36" y="18"/><di:waypoint x="180" y="18"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_t2" bpmnElement="t2">
        <di:waypoint x="280" y="18"/><di:waypoint x="360" y="18"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_t3" bpmnElement="t3">
        <di:waypoint x="396" y="18"/><di:waypoint x="540" y="18"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_t4" bpmnElement="t4">
        <di:waypoint x="640" y="18"/><di:waypoint x="720" y="18"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_t_ok" bpmnElement="t_ok">
        <di:waypoint x="745" y="-7"/><di:waypoint x="745" y="-42"/><di:waypoint x="900" y="-42"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_t_reject" bpmnElement="t_reject">
        <di:waypoint x="745" y="43"/><di:waypoint x="745" y="78"/><di:waypoint x="900" y="78"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
