{
  "name": "atlas-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Atlas Automation — service-based media/broadcast automation platform. Nx monorepo: shared libraries under libs/, deployables under apps/, design docs under docs/.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "libs/*",
    "apps/*",
    "spikes/*"
  ],
  "scripts": {
    "test": "nx run-many -t test",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "build": "nx run-many -t build",
    "affected:test": "nx affected -t test",
    "affected:lint": "nx affected -t lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "graph": "nx graph",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "nx": "^23.1.0",
    "prettier": "^3.4.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0"
  }
}
